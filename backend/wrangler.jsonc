{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kevin-bai-chat",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"vars": {
		"ALLOWED_ORIGINS": "https://kevin-bai.com",
		"OPENAI_MODEL": "gpt-6-luna"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kevin-bai-chat",
			"database_id": "08eee5e0-2ead-4c41-a022-cde776204404",
			"migrations_dir": "migrations"
		},
		{
			"binding": "kevin_bai_chat",
			"database_name": "kevin-bai-chat",
			"database_id": "08eee5e0-2ead-4c41-a022-cde776204404",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "BURST_LIMITER",
			"namespace_id": "612701",
			"simple": {
				"limit": 12,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	}
}